# Copy to .env locally. The preview needs no secrets.
# Keep this false until the user explicitly approves paid verification.
LIVE_INFERENCE_ENABLED=false
NEBIUS_API_KEY=
# Exact NVIDIA model ID, verified when paid testing is approved.
NEBIUS_MODEL=
# Separate private passphrase authorizing live requests, not the API key.
RUN_ACCESS_TOKEN=
PORT=4173

NEBIUS_ALLOWED_MODELS=nvidia/Nemotron-3_5-Lightning,nvidia/nemotron-3-super-120b-a12b
MAX_DAILY_CASES=60
MAX_MINUTE_CASES=24
QUOTA_DB_PATH=.local-state/quota.sqlite
