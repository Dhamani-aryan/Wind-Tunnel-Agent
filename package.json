{
  "name": "agent-wind-tunnel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/compose.mjs && bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "assurance": "node scripts/check-assurance.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
